---
import { Icon } from 'astro-icon/components';

import PageLayout from '~/layouts/PageLayout.astro';
import { chapters, manualMeta } from '~/data/manual';
import { getPermalink } from '~/utils/permalinks';

import heroImage from '~/assets/images/akagera/photo_03_wide.jpg';

const metadata = {
  title: 'Community management Framework for National Parks',
  ignoreTitleTemplate: true,
  description: manualMeta.projectSummary,
};

const frameworkSteps = [
  {
    number: 1,
    title: 'Setting the scene',
    bullets: [
      'Who to be included in the process and how',
      'Conducting a comprehensive community and stakeholder analysis',
      'Defining objectives',
    ],
  },
  {
    number: 2,
    title: 'Targeting',
    bullets: [
      'Identification of the problems',
      'Identification of target groups',
      'Prioritisation of the problems and objectives',
    ],
  },
  {
    number: 3,
    title: 'Focusing on target',
    bullets: [
      'Formulating desired behaviours',
      'Analyze barriers to best practices',
      'Develop key messages to support behaviour change',
    ],
  },
  {
    number: 4,
    title: 'Designing',
    bullets: ['Determination of outreach components', 'Set result and impact indicators'],
  },
  {
    number: 5,
    title: 'Implementing & monitoring',
    bullets: ['Use of indicators in adaptive management'],
  },
];

const expectedImpact = [
  {
    icon: 'tabler:target-arrow',
    title: 'Effective planning',
    text: 'Strategic planning of the teams moves beyond general concepts to specific applications.',
  },
  {
    icon: 'tabler:rocket',
    title: 'Effective implementation',
    text: 'The teams get proficient in use of Social behavior change orientation.',
  },
  {
    icon: 'tabler:clipboard-check',
    title: 'Field validation as a standard practice',
    text: 'The team engages in practical exercises to validate their assumptions about target groups and messages directly with community members. This includes assessing the relevance of identified problems and messages to specific groups.',
  },
  {
    icon: 'tabler:chart-bar',
    title: 'Advanced analytic tools',
    text: 'Ability to use advanced tools like the Barrier Analysis for teachers regarding Human-Wildlife Conflict (HWC) or the Key Informant Interviews.',
  },
  {
    icon: 'tabler:puzzle',
    title: 'Strategic Integration',
    text: 'Use of Bridges to activities tools, integrating specific activities into the broader community strategy. This ensures that every activity has a clear strategic purpose and is not conducted in isolation.',
  },
  {
    icon: 'tabler:gauge',
    title: 'Monitoring framework definition',
    text: 'The team defines specific indicators for strategic monitoring, ensuring that the impact of activities could be tracked and measured over time.',
  },
];

const chapterBorderColors = ['#3f5644', '#62835d', '#8d7456', '#91789f', '#6d8f5f', '#546f79'];
---

<PageLayout metadata={metadata}>
  <section class="hero-section relative w-full overflow-hidden text-white">
    <img
      src={heroImage.src}
      alt="Giraffes in Akagera"
      class="hero-photo absolute inset-0 h-full w-full object-cover"
      loading="eager"
    />
    <div class="hero-overlay absolute inset-0"></div>

    <div
      class="relative mx-auto flex min-h-[86svh] max-w-7xl flex-col justify-center px-6 py-20 md:min-h-[88vh] md:py-24"
    >
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-[#dfe8d8]">{manualMeta.version}</p>
      <h1 class="max-w-4xl font-heading text-5xl leading-[1.02] md:text-7xl">
        Community management Framework for National Parks
      </h1>
      <p class="mt-6 max-w-3xl text-base leading-relaxed text-[#e8efe5] md:text-xl">
        Methodological overview of building Conservation constituencies. Practical steps to harmonise conservation and
        community outreach within one strategy.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href={manualMeta.pdfPath}
          download
          class="btn-primary !bg-[#6e8e62] !border-[#6e8e62] hover:!bg-[#5e7b54] hover:!border-[#5e7b54]"
        >
          Download the guide
          <Icon name="tabler:download" class="ml-2 h-5 w-5" />
        </a>
        <button
          id="toolbox-button"
          type="button"
          class="btn-secondary !border-[#dce7d4]/70 !bg-white/5 !text-[#dce7d4] !opacity-75 cursor-not-allowed"
          aria-disabled="true"
          title="Toolbox download is not ready yet"
        >
          Download Toolbox
        </button>
      </div>
      <p id="toolbox-note" class="mt-3 hidden text-sm text-[#dce7d4]">
        Toolbox is in preparation and will be ready for download soon.
      </p>

      <div class="mt-10 grid max-w-4xl grid-cols-1 gap-3 text-sm md:grid-cols-3">
        <div class="rounded-2xl border border-white/20 bg-white/10 px-4 py-4 backdrop-blur">
          <p class="text-2xl font-semibold">42</p>
          <p class="text-[#dce7d4]">Pages in the manual</p>
        </div>
        <div class="rounded-2xl border border-white/20 bg-white/10 px-4 py-4 backdrop-blur">
          <p class="text-2xl font-semibold">6</p>
          <p class="text-[#dce7d4]">Core parts in the framework</p>
        </div>
        <div class="rounded-2xl border border-white/20 bg-white/10 px-4 py-4 backdrop-blur">
          <p class="text-2xl font-semibold">1</p>
          <p class="text-[#dce7d4]">Operational case study: Akagera</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What this guidance delivers -->
  <section id="project" class="w-full bg-[#eff2e9]">
    <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#4f6957]">Overview</p>
      <h2 class="mt-3 font-heading text-4xl leading-tight text-[#1f3226] md:text-5xl">What this guidance delivers</h2>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-[#304238] md:text-lg">
        A field-ready manual for Community Outreach Teams to design conservation outreach as a measurable strategy, not
        a list of activities.
      </p>
    </div>
  </section>

  <!-- Why is this Framework worth my attention -->
  <section class="w-full border-y border-black/5 bg-[#f6f7f2]">
    <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#4f6957]">Core rationale</p>
      <h2 class="mt-3 font-heading text-4xl leading-tight text-[#1f3226] md:text-5xl">
        Why is this Framework worth my attention
      </h2>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-[#304238] md:text-lg">
        The framework implies a fundamental transition: the relationship of communities with a national park is meant to
        evolve from one based on enforced exclusion (protectionism) to one rooted in shared value and mutual
        accommodation (coexistence), achieved by providing benefits with minimum cost to the community.
      </p>
      <p class="mt-5 max-w-3xl text-base font-bold leading-relaxed text-[#1f3226] md:text-lg">
        "While enforced protection remains necessary in the short term, the ultimate vision is a socio-ecologically
        resilient landscape where biodiversity thrives because local communities willingly choose conservation as the
        best land-use outcome."
      </p>

      <div class="mt-10">
        <h3 class="text-2xl font-semibold text-[#24372c]">Who it helps</h3>
        <p class="mt-3 max-w-3xl text-base leading-relaxed text-[#304238] md:text-lg">
          Primary users are park community teams and managers, with direct value for district authorities, teachers,
          community leaders, and implementation partners.
        </p>
      </div>
    </div>
  </section>

  <!-- The Framework - Stepper -->
  <section class="w-full bg-[#eff2e9]">
    <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#4f6957]">Process</p>
      <h2 class="mt-3 font-heading text-4xl leading-tight text-[#1f3226] md:text-5xl">The Framework</h2>

      <!-- Desktop: 5 cards in one row with connectors -->
      <div class="mt-10 hidden lg:flex lg:items-start lg:gap-0">
        {
          frameworkSteps.map((step, i) => (
            <Fragment>
              <article class="flex-1 rounded-2xl border border-[#d3dcc9] bg-white px-4 py-5 shadow-[0_12px_24px_rgba(30,49,37,0.07)]">
                <span class="mb-3 inline-flex h-8 w-8 items-center justify-center rounded-full bg-[#4f6957] text-sm font-bold text-white">
                  {step.number}
                </span>
                <h3 class="text-lg font-semibold text-[#24372c]">{step.title}</h3>
                <ul class="mt-3 space-y-1.5">
                  {step.bullets.map((bullet) => (
                    <li class="flex gap-2 text-sm leading-relaxed text-[#3b4f43]">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#6b8b61]" />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </article>
              {i < frameworkSteps.length - 1 && (
                <div class="flex shrink-0 items-center px-1 pt-10">
                  <Icon name="tabler:chevron-right" class="h-5 w-5 text-[#6b8b61]" />
                </div>
              )}
            </Fragment>
          ))
        }
      </div>

      <!-- Mobile: vertical stepper with left connector line -->
      <div class="mt-10 lg:hidden">
        <div class="relative ml-4 border-l-2 border-[#6b8b61]/40 pl-6">
          {
            frameworkSteps.map((step) => (
              <div class="relative mb-8 last:mb-0">
                <span class="absolute -left-[calc(1.5rem+1px)] top-0 inline-flex h-8 w-8 items-center justify-center rounded-full bg-[#4f6957] text-sm font-bold text-white">
                  {step.number}
                </span>
                <article class="rounded-2xl border border-[#d3dcc9] bg-white px-4 py-5 shadow-[0_12px_24px_rgba(30,49,37,0.07)]">
                  <h3 class="text-lg font-semibold text-[#24372c]">{step.title}</h3>
                  <ul class="mt-3 space-y-1.5">
                    {step.bullets.map((bullet) => (
                      <li class="flex gap-2 text-sm leading-relaxed text-[#3b4f43]">
                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#6b8b61]" />
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Expected Impact -->
  <section class="w-full border-y border-black/5 bg-[#f6f7f2]">
    <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#4f6957]">Outcomes</p>
      <h2 class="mt-3 font-heading text-4xl leading-tight text-[#1f3226] md:text-5xl">
        Expected Impact of the guidance content on teams and processes
      </h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          expectedImpact.map((item) => (
            <article class="rounded-2xl border border-[#d3dcc9] bg-white px-5 py-5 shadow-[0_12px_24px_rgba(30,49,37,0.07)]">
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-[#4f6957] text-white">
                <Icon name={item.icon} class="h-5 w-5" />
              </div>
              <h3 class="text-lg font-semibold text-[#24372c]">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[#3b4f43]">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="chapters" class="w-full bg-[#eef1e8]">
    <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#4f6957]">Guide structure</p>
      <h2 class="mt-3 font-heading text-4xl leading-tight text-[#1f3226] md:text-5xl">Chapters with dedicated pages</h2>
      <p class="mt-4 max-w-3xl text-[#33453a]">
        All chapter parts are combined on one heavy chapters page with direct section anchors.
      </p>

      <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {
          chapters.map((chapter, index) => (
            <article
              class="rounded-2xl border-2 bg-white p-5 shadow-[0_12px_28px_rgba(30,49,37,0.08)] transition hover:-translate-y-0.5"
              style={`border-color: ${chapterBorderColors[index]};`}
            >
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[#5e7463]">{chapter.label}</p>
              <h3 class="mt-2 text-xl font-semibold text-[#23362b]">{chapter.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-[#405447]">{chapter.summary}</p>
              <a
                href={`${getPermalink('/chapters')}/#${chapter.slug}`}
                class="mt-4 inline-flex items-center text-sm font-semibold text-[#365540] hover:text-[#243d2e]"
              >
                Open chapter section
                <Icon name="tabler:arrow-up-right" class="ml-1 h-4 w-4" />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="w-full bg-[#2d4334] text-white">
    <div
      class="mx-auto flex max-w-7xl flex-col items-start gap-6 px-6 py-16 md:flex-row md:items-center md:justify-between md:py-20"
    >
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#c9d7c0]">Ready to use</p>
        <h2 class="mt-3 font-heading text-4xl leading-tight md:text-5xl">Download the full guidance manual</h2>
        <p class="mt-4 max-w-2xl text-[#dbe5d5]">Primary document for implementation teams and partners.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href={manualMeta.pdfPath}
          download
          class="btn-primary !bg-[#89a86d] !border-[#89a86d] hover:!bg-[#78985d] hover:!border-[#78985d]"
        >
          Download PDF
          <Icon name="tabler:download" class="ml-2 h-5 w-5" />
        </a>
        <a href="#project" class="btn-secondary !border-white/50 !text-white hover:!bg-white/15">Back to overview</a>
      </div>
    </div>
  </section>
</PageLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  .hero-section {
    background-color: #223629;
  }

  .hero-photo {
    filter: saturate(88%) contrast(93%);
  }

  .hero-overlay {
    background:
      linear-gradient(102deg, rgba(24, 43, 31, 0.9) 14%, rgba(40, 63, 48, 0.76) 52%, rgba(26, 44, 34, 0.84) 100%),
      linear-gradient(180deg, rgba(24, 41, 30, 0.1) 0%, rgba(24, 41, 30, 0.64) 100%);
  }

  @media (max-width: 767px) {
    .hero-photo {
      object-position: 68% center;
    }
  }
</style>

<script>
  const toolboxButton = document.getElementById('toolbox-button');
  const toolboxNote = document.getElementById('toolbox-note');

  if (toolboxButton && toolboxNote) {
    toolboxButton.addEventListener('click', () => {
      toolboxNote.classList.remove('hidden');
    });
  }
</script>
